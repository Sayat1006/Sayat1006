# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Auth.js / NextAuth -------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
# The canonical URL of this app. http://localhost:3000 in local dev.
NEXTAUTH_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role secret.
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_, never send it to
# the browser, never commit it. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---------------------------------------------------------------
# SERVER-SIDE ONLY — read only inside lib/ai/providers/openai.ts, never sent
# to the browser. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Any current OpenAI model your account has access to. Defaults to
# gpt-4o-mini if left blank.
OPENAI_MODEL=gpt-4o-mini
